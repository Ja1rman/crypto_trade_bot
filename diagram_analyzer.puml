@startuml
namespace analyzer {
    class CurrencySettings << (S,Aquamarine) >> {
        + MIN_PROFIT float64
        + MIN_MONEY_DEAL float64
        + CURRENCY_ROUTES <font color=blue>map</font>[string]<font color=blue>map</font>[string]<font color=blue>struct</font>{}
        + SUBSCRIBE_TICKERS_LIST <font color=blue>map</font>[string]config.Info
        + START_CURRENCIES StartCurrencies
        + LAST_ALERT_SENT <font color=blue>map</font>[string]time.Time
        + ALL_PATHS [][]string
        + COMMISSION float64
        + PRICES handlers.Prices
        + MARKET string

        - searchTradingPaths() 
        - tradingPathsSearching(currencies []string, currentDepth int, minDepth int, maxDepth int) 
        - analyzeForAllPaths() 
        - processAnalyze(currencies []string) 
        - buyDecision(tradingPairs TradingPairs, balances []float64, currencies []string) 
        - checkBalance() 
        - createFirstOrder(info config.Info, size float64, price float64, symbol string, coin string) (float64, error)

        + LaunchInfiniteAnalyze() 
        + ProcessCycle(startSize float64, firstOrderPrice float64, pairsNames []string, exchange string) 
        + SellAll(pairsNames []string, qty float64) error
        + CreateSellOrder(info config.Info, size float64, symbol string, coin string) (float64, error)
        + ProcessFirstPair(size float64, price float64, pairsNames []string) (float64, error)
        + CreateOrderAndGetResult(symbol string, price float64, qty float64, coinType string, side string, orderType string, inversion bool) (float64, error)
        + GetWalletBalance(coins string) (<font color=blue>map</font>[string]float64, error)
        + FindSymbol(firstCurrency string, secondCurrency string) (string, config.Info, error)

    }
    class MoneyLimits << (S,Aquamarine) >> {
        + StopBalance float64
        + MaxDealPrice float64

    }
    class StartCurrencies << (S,Aquamarine) >> {
        + Cache <font color=blue>map</font>[string]MoneyLimits

    }
    class analyzer.TradingPairs << (T, #FF7700) >>  {
    }
    class "[]handlers.OrderBookData" as handlersOrderBookData {
        'This class was created so that we can correctly have an alias pointing to this name. Since it contains dots that can break namespaces
    }
}
"sync.RWMutex" *-- "analyzer.StartCurrencies"


namespace config {
    class Info << (S,Aquamarine) >> {
        + BaseCoin string
        + QuoteCoin string
        + Precision Precision
        + TickSize float64

    }
    class Precision << (S,Aquamarine) >> {
        + BasePrecision float64
        + QuotePrecision float64

    }
}


namespace handlers {
    class OrderBookData << (S,Aquamarine) >> {
        + Ask StockExchangeGlassNote
        + Bid StockExchangeGlassNote

    }
    class OrderBookJsonData << (S,Aquamarine) >> {
        + Symbol string
        + Bids [][]string
        + Asks [][]string
        + Update int64
        + Seq int64

    }
    class Prices << (S,Aquamarine) >> {
        + Cache <font color=blue>map</font>[string]OrderBookData

        + UpdateOrdersBook(msg OrderBookJsonData, ts int64) 
        + UpdatePriceMap(symbol string, newItem OrderBookData, update int64) 
        + GetOrderBookData(symbol string) OrderBookData
        + GetLenOfPrices() int

    }
    class StockExchangeGlassNote << (S,Aquamarine) >> {
        + Price float64
        + Size float64
        + Seq int64
        + Ts int64

    }
}
"sync.RWMutex" *-- "handlers.Prices"


namespace trade {
    class AccountResponse << (S,Aquamarine) >> {
        + CanTrade bool
        + CanWithdraw bool
        + CanDeposit bool
        + UpdateTime *int64
        + AccountType string
        + Balances []Balance
        + Permissions []string

    }
    class Balance << (S,Aquamarine) >> {
        + Asset string
        + Free string
        + Locked string

    }
    class OrderInfoResponse << (S,Aquamarine) >> {
        + Symbol string
        + OrderID int64
        + OrderListID int64
        + ClientOrderID string
        + Price string
        + Qty string
        + ExecutedQty string
        + CummulativeQuoteQty string
        + Status string
        + TimeInForce string
        + Type string
        + Side string
        + StopPrice string
        + Time int64
        + UpdateTime int64
        + IsWorking bool
        + OrigQuoteOrderQty string

    }
    class OrderResponse << (S,Aquamarine) >> {
        + OrderID string

    }
}


namespace utils {
    class ExchangeInfo << (S,Aquamarine) >> {
        + Timezone string
        + ServerTime int64
        + RateLimits []any
        + ExchangeFilters []any
        + Symbols []Symbol

    }
    class InstrumentInfo << (S,Aquamarine) >> {
        + Symbol string
        + BaseCoin string
        + QuoteCoin string
        + Innovation string
        + Status string
        + MarginTrading string
        + StTag string
        + LotSizeFilter <font color=blue>struct</font>{string, string, string, string, string, string}
        + PriceFilter <font color=blue>struct</font>{string}
        + RiskParams <font color=blue>struct</font>{string, string}

    }
    class Symbol << (S,Aquamarine) >> {
        + Symbol string
        + Status string
        + BaseAsset string
        + BaseAssetPrecision int
        + QuoteAsset string
        + QuotePrecision int
        + QuoteAssetPrecision int
        + BaseCommissionPrecision int
        + QuoteCommissionPrecision int
        + OrderTypes []string
        + QuoteOrderQtyMarketAllowed bool
        + IsSpotTradingAllowed bool
        + IsMarginTradingAllowed bool
        + QuoteAmountPrecision string
        + BaseSizePrecision string
        + Permissions []string
        + Filters []any
        + MaxQuoteAmount string
        + MakerCommission string
        + TakerCommission string
        + TradeSideType int

    }
}


namespace ws_connections {
    class OrderBookJsonMessage << (S,Aquamarine) >> {
        + Topic string
        + Type string
        + Ts int64
        + Data handlers.OrderBookJsonData
        + Cts int64

    }
}


"analyzer.handlersOrderBookData" #.. "analyzer.TradingPairs"
@enduml
